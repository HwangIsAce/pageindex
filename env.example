# PageIndex API - Environment variables
# Copy to .env and fill in values

# Required: OpenAI API key for indexing and retrieval
CHATGPT_API_KEY=sk-...

# Optional: Data directory (default: ./data)
# PAGEINDEX_DATA_DIR=data

# Optional: CORS allowed origins (comma-separated, default: * for all)
# Production: https://your-frontend.example.com,https://app.example.com
# CORS_ORIGINS=*

# Optional: Max upload size in bytes (default: 100MB)
# MAX_UPLOAD_BYTES=104857600

# Optional: Logging - LOG_FORMAT=json for JSON lines, LOG_LEVEL=DEBUG
# LOG_FORMAT=text
# LOG_LEVEL=INFO
